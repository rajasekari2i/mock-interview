# Runtime environment: development, test, or production.
APP_ENV=development

# PostgreSQL SQLAlchemy URL. Replace every placeholder; never commit a real credential.
DATABASE_URL=postgresql+psycopg://mockinterview:<database-password>@localhost:5432/mockinterview

# Google OIDC server-side credentials and exact callback URL.
GOOGLE_OIDC_CLIENT_ID=<google-client-id>
GOOGLE_OIDC_CLIENT_SECRET=<google-client-secret>
GOOGLE_OIDC_ISSUER=https://accounts.google.com
GOOGLE_OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Comma-separated key-id=Fernet-key entries, newest first. Retain the previous key until every
# OAuth transaction encrypted with it has expired. Generate keys outside the repository.
OAUTH_TRANSACTION_ENCRYPTION_KEYS=current=<fernet-key>,previous=<previous-fernet-key>
OAUTH_TRANSACTION_TTL_SECONDS=600
OAUTH_RETURN_PATHS=/,/candidate,/manager,/admin

# Session policy is fixed by the approved feature specification.
SESSION_ABSOLUTE_SECONDS=28800
SESSION_IDLE_SECONDS=7200
SESSION_COOKIE_NAME=mi_session_dev
SESSION_COOKIE_SECURE=false

# Exact JSON origin allowlists; wildcard origins are invalid with credentialed requests.
FRONTEND_ORIGINS=["http://localhost:5173"]
CSRF_ALLOWED_ORIGINS=["http://localhost:5173"]
# Single trusted origin used to build absolute OAuth success and error redirects. It must be a
# member of both allowlists above; production requires HTTPS.
FRONTEND_APPLICATION_ORIGIN=http://localhost:5173

# Deterministic provider is test-only. Production startup rejects true.
ENABLE_FAKE_OIDC=false

# Browser configuration contains no secrets.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Optional development seed argument (CLI, not a runtime secret):
#   --domain-mapping example.test:acme
